# Supabase — projet "statwise" (eu-west-3, Paris)
# L'URL et la clé publiable partent dans le navigateur : elles ne sont pas secrètes.
# Ce qui protège les données, ce sont les politiques RLS, pas ces deux valeurs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role : contourne RLS. Serveur uniquement, jamais dans un composant
# client. Non nécessaire au fonctionnement des comptes ; à ne renseigner que pour
# un import ou un job d'administration.
SUPABASE_SERVICE_ROLE_KEY=
